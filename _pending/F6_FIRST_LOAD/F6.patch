+	// ---- A GUN'S FIRST LOAD (WM_Gun.TakeFirstLoad) ---------------------------------
+
+	// THE MAIN BARREL'S OWN STORE? Not a placeholder, never a second barrel's (its ammo is not the gun's).
+	private bool MainStore(WM_Store s, WM_Card card)
+	{
+		return s && !s.placeholder && !(card && card.IsBarrelStore(s.id));
+	}
+
+	// HOW MANY ROUNDS THE MAIN BARREL'S STORES HOLD right now: every counted round and every live slot.
+	int MainRounds(WM_Card card)
+	{
+		int n = 0;
+		for (int i = 0; i < stores.Size(); i++)
+		{
+			let s = stores[i];
+			if (!MainStore(s, card)) continue;
+			if (s.kind == WM_Store.COUNTED) { n += s.rounds; continue; }
+			for (int k = 0; k < s.slots.Size(); k++) if (s.slots[k] == WM_Store.SLOT_LIVE) n++;
+		}
+		return n;
+	}
+
+	// LOADED WITH n ROUNDS INSTEAD OF FULL: the main barrel's stores emptied, then filled chamber first (what a
+	// pull spends), then the magazine, then any other store of the gun's own, each to its capacity. A second
+	// barrel's store is left as Init filled it. The action stays closed: an empty chamber is racked by hand.
+	void LoadFirst(int n, WM_Card card)
+	{
+		for (int i = 0; i < stores.Size(); i++)
+		{
+			let s = stores[i];
+			if (!MainStore(s, card)) continue;
+			if (s.kind == WM_Store.COUNTED) s.rounds = 0;
+			else for (int k = 0; k < s.slots.Size(); k++) s.slots[k] = WM_Store.SLOT_EMPTY;
+		}
+		int left = max(n, 0);
+		left = LoadInto(chamberStore, left, card);
+		left = LoadInto(magStore, left, card);
+		for (int i = 0; i < stores.Size() && left > 0; i++)
+			if (stores[i] != chamberStore && stores[i] != magStore) left = LoadInto(stores[i], left, card);
+		actionLock = false;
+		Sync();
+	}
+
+	// Up to n rounds into one store; what is left over.
+	private int LoadInto(WM_Store s, int n, WM_Card card)
+	{
+		if (n <= 0 || !MainStore(s, card)) return n;
+		if (s.kind == WM_Store.COUNTED)
+		{
+			int put = min(n, s.capacity - s.rounds);
+			s.rounds += put;
+			return n - put;
+		}
+		for (int k = 0; k < s.slots.Size() && n > 0; k++)
+		{
+			if (s.slots[k] != WM_Store.SLOT_EMPTY) continue;
+			s.slots[k] = WM_Store.SLOT_LIVE;
+			n--;
+		}
+		return n;
+	}
+

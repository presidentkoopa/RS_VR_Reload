 	// for a free reload.
 	WM_Ammo wmAmmo;
 
+	// A GUN'S FIRST LOAD, FROM ITS PICKUP (VANILLA_PARITY G5 / F6). A pickup that brings ammo with the gun offers it
+	// here before handing the gun over: the gun keeps what it holds, the pickup gives the rest to the reserve, and
+	// the gun arrives loaded with the pickup's own rounds and no more -- Doom's economy, where a BFG pickup is 40
+	// cells. A gun given any other way (the start loadout, a console give) never has one set and comes full, as before.
+	bool firstLoadSet;
+	int  firstLoadRounds;
+
+	// HOW MANY OF `offered` ROUNDS THIS GUN TAKES as its first load; the caller gives the rest to the reserve.
+	// Playsim: a pickup calls it on every machine, before CallTryPickup, and it reads only this class's card, which
+	// every machine loads. 0 for a gun that has already been in a hand (its rounds are its own by then) or keeps none.
+	int TakeFirstLoad(int offered)
+	{
+		if (wmAmmo) return 0;
+		let sys = WM_System(EventHandler.Find("WM_System"));
+		let card = sys ? sys.CardForWeapon(GetClassName()) : null;
+		if (!card || card.KeepsNoRounds()) return 0;
+		let full = new("WM_Ammo");
+		full.Init(card.capacity, card);
+		int took = clamp(offered, 0, full.MainRounds(card));
+		firstLoadSet    = true;
+		firstLoadRounds = took;
+		return took;
+	}
+
 	int Hand() { return bOffhandWeapon ? 1 : 0; }
 
